{
  "schema": "termux-os.package.v1",
  "id": "github.termux-os.service.hf-model-manager",
  "name": "模型管理",
  "version": "0.4.8",
  "description": "Raw-only model package catalog and file manager: Registry metadata, Manager-selected sources, Framework-owned transfer, local status, update, archive import, and confirmed deletion",
  "types": [
    "service"
  ],
  "compatibility": {
    "framework": ">=0.3.4"
  },
  "entrypoints": {
    "backend": "package.mjs",
    "webui": "web/index.html"
  },
  "admin": {
    "title": "模型管理"
  },
  "verification": {
    "device": {
      "command": "node scripts/verify-device.mjs",
      "timeout_ms": 120000,
      "requires_running": true
    }
  },
  "components": {
    "services": [
      "hf-model-manager"
    ],
    "actions": [
      "assets.manager.query"
    ],
    "apps": []
  },
  "capabilities": {
    "provides": [
      {
        "id": "termux-os.assets.manager",
        "provider": "hf-model-manager",
        "kind": "action",
        "action": "assets.manager.query"
      },
      {
        "id": "termux-os.assets.inventory",
        "provider": "hf-model-manager",
        "kind": "feed",
        "service": "hf-model-manager",
        "endpoint": "/api/packages/github.termux-os.service.hf-model-manager/events",
        "format": "jsonl-cursor"
      }
    ],
    "requires": []
  },
  "menu": [
    {
      "parent": "/admin/services",
      "path": "/packages/github.termux-os.service.hf-model-manager/",
      "title": "模型管理",
      "order": 110
    }
  ],
  "ports": [
    {
      "id": "http",
      "protocol": "http",
      "visibility": "loopback",
      "health": "/health"
    }
  ],
  "runtime": {
    "framework": {
      "commands": [
        "node"
      ]
    },
    "termux_packages": [],
    "bundled": [],
    "external": []
  },
  "release": {
    "repository": "https://github.com/johnson-yo/termux_os-service-hf_model_manager",
    "license": "Apache-2.0",
    "homepage": "https://github.com/johnson-yo/termux_os-service-hf_model_manager"
  }
}
